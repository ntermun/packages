# Maintainer: ntermun
# Static aarch64/musl build.  Build with: repo/makepkg.sh bzip2
#
# bzip2 still ships a hand written Makefile: no configure, no DESTDIR.
pkgname=bzip2
pkgver=1.0.8
pkgrel=1
pkgdesc="A high-quality data compression program (static musl)"
url="https://sourceware.org/bzip2/"
arch=(aarch64)
license=(BSD)
depends=()
source=("https://sourceware.org/pub/bzip2/bzip2-${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
	cd "$srcdir/$pkgname-$pkgver"
	make -j"$JOBS" CC="$CC" AR="$AR" RANLIB="$RANLIB" \
		CFLAGS="$CFLAGS -Wall" LDFLAGS="$LDFLAGS" \
		bzip2 bzip2recover
	make -j"$JOBS" CC="$CC" AR="$AR" RANLIB="$RANLIB" \
		CFLAGS="$CFLAGS -Wall" libbz2.a
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	install -Dm755 bzip2 "$pkgdir/usr/bin/bzip2"
	install -Dm755 bzip2recover "$pkgdir/usr/bin/bzip2recover"
	ln -s bzip2 "$pkgdir/usr/bin/bunzip2"
	ln -s bzip2 "$pkgdir/usr/bin/bzcat"
	install -Dm644 bzlib.h "$pkgdir/usr/include/bzlib.h"
	install -Dm644 libbz2.a "$pkgdir/usr/lib/libbz2.a"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/bzip2/LICENSE"
}
