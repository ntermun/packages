# Maintainer: nterminal <d0m_1k@mail.ru>
# Static aarch64-linux-musl build.  Built by ../../ci-build.sh (mini-makepkg),
# not by makepkg, and installed under /usr on the target.

pkgname=diffutils
pkgver=3.10
pkgrel=1
pkgdesc='GNU diffutils: diff, cmp, sdiff (static, musl)'
arch=('aarch64')
url='https://www.gnu.org/software/diffutils/'
license=('GPL-3.0-or-later')
depends=()
makedepends=('aarch64-linux-musl-gcc')
source=("https://ftp.gnu.org/gnu/diffutils/diffutils-${pkgver}.tar.xz")
sha256sums=('SKIP')

build() {
	cd "${srcdir}/diffutils-${pkgver}"
	./configure \
		--host="${CROSS}" \
		--prefix=/usr \
		--disable-nls \
		CFLAGS="${CFLAGS}" \
		LDFLAGS="${LDFLAGS}"
	make -j"${JOBS}"
}

package() {
	cd "${srcdir}/diffutils-${pkgver}"
	make DESTDIR="${pkgdir}" install
	chmod 755 "${pkgdir}"/usr/bin/*
	rm -rf "${pkgdir}"/usr/share/info "${pkgdir}"/usr/share/locale
}
