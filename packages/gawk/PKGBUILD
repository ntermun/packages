# Maintainer: ntermun
# Static aarch64/musl build.  Build with: repo/makepkg.sh gawk
pkgname=gawk
pkgver=5.4.1
pkgrel=1
pkgdesc="GNU awk (static musl)"
url="https://www.gnu.org/software/gawk/"
arch=(aarch64)
license=(GPL-3.0-or-later)
depends=()
source=("https://ftp.gnu.org/gnu/gawk/gawk-${pkgver}.tar.xz")
sha256sums=('SKIP')

build() {
	cd "$srcdir/$pkgname-$pkgver"
	./configure \
		--host="$CHOST" --build="$CBUILD" \
		--prefix=/usr \
		--disable-nls \
		--disable-shared --enable-static \
		--disable-extensions --disable-mpfr
	make -j"$JOBS"
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
}
