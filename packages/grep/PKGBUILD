# Maintainer: nterminal <d0m_1k@mail.ru>
# Static aarch64-linux-musl build.  Built by ../../ci-build.sh (mini-makepkg),
# not by makepkg, and installed under /usr on the target.

pkgname=grep
pkgver=3.11
pkgrel=1
pkgdesc='GNU grep (static, musl)'
arch=('aarch64')
url='https://www.gnu.org/software/grep/'
license=('GPL-3.0-or-later')
depends=()
makedepends=('aarch64-linux-musl-gcc')
source=("https://ftp.gnu.org/gnu/grep/grep-${pkgver}.tar.xz")
sha256sums=('SKIP')

build() {
	cd "${srcdir}/grep-${pkgver}"
	./configure \
		--host="${CROSS}" \
		--prefix=/usr \
		--disable-nls \
		--disable-perl-regexp \
		CFLAGS="${CFLAGS}" \
		LDFLAGS="${LDFLAGS}"
	make -j"${JOBS}"
}

package() {
	cd "${srcdir}/grep-${pkgver}"
	make DESTDIR="${pkgdir}" install
	chmod 755 "${pkgdir}"/usr/bin/*
	rm -rf "${pkgdir}"/usr/share/info "${pkgdir}"/usr/share/locale
}
