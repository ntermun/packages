# Maintainer: ntermun
# Static aarch64/musl build.  Build with: repo/makepkg.sh gzip
pkgname=gzip
pkgver=1.15
pkgrel=1
pkgdesc="GNU gzip (static musl)"
url="https://www.gnu.org/software/gzip/"
arch=(aarch64)
license=(GPL-3.0-or-later)
depends=()
source=("https://ftp.gnu.org/gnu/gzip/gzip-${pkgver}.tar.xz"
        "gzip-1.15-musl-head-macro.patch")
sha256sums=('SKIP')

build() {
	cd "$srcdir/$pkgname-$pkgver"
	./configure \
		--host="$CHOST" --build="$CBUILD" \
		--prefix=/usr \
		--disable-nls \
		--disable-shared --enable-static
	make -j"$JOBS"
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
}
