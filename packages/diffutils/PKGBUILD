# Maintainer: ntermun
# Static aarch64/musl build.  Build with: repo/makepkg.sh diffutils
pkgname=diffutils
pkgver=3.12
pkgrel=1
pkgdesc="GNU diff/diff3/sdiff/cmp (static musl)"
url="https://www.gnu.org/software/diffutils/"
arch=(aarch64)
license=(GPL-3.0-or-later)
depends=()
source=("https://ftp.gnu.org/gnu/diffutils/diffutils-${pkgver}.tar.xz")
sha256sums=('SKIP')

build() {
	cd "$srcdir/$pkgname-$pkgver"
	./configure \
		--host="$CHOST" --build="$CBUILD" \
		--prefix=/usr \
		--disable-nls \
		--disable-shared --enable-static \
		gl_cv_func_strcasecmp_works=yes
	make -j"$JOBS"
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
}
