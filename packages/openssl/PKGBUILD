# Maintainer: nterminal <d0m_1k@mail.ru>
# Static aarch64-linux-musl build.  Built by ../../ci-build.sh (mini-makepkg),
# not by makepkg, and installed under /usr on the target.

pkgname=openssl
pkgver=3.5.1
pkgrel=1
pkgdesc='OpenSSL toolkit and libcrypto/libssl (static, musl)'
arch=('aarch64')
url='https://www.openssl.org/'
license=('Apache-2.0')
depends=()
makedepends=('aarch64-linux-musl-gcc' 'perl')
source=("https://www.openssl.org/source/openssl-${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
	cd "${srcdir}/openssl-${pkgver}"
	./Configure linux-aarch64 \
		--prefix=/usr \
		--libdir=lib \
		--openssldir=/usr/lib/ssl \
		no-shared \
		no-tests \
		CFLAGS="${CFLAGS}" \
		LDFLAGS="${LDFLAGS}"
	make -j"${JOBS}"
}

package() {
	cd "${srcdir}/openssl-${pkgver}"
	make DESTDIR="${pkgdir}" install_sw install_ssldirs
	chmod 755 "${pkgdir}"/usr/bin/*
	rm -rf "${pkgdir}/usr/share/doc"
}
